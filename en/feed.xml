---
layout: none
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
	<channel>
		<title>{{ site.data.locale.en.SITE_TITLE | default: site.title | xml_escape }}</title>
		<description>{{ site.data.locale.en.SITE_DESCRIPTION | default: site.description | xml_escape }}</description>
		<link>{{ site.url }}/en/</link>
		<atom:link href="{{ site.url }}/en/feed.xml" rel="self" type="application/rss+xml" />
		{% assign posts_en = site.posts_en | sort: 'date' | reverse %}
		{% for post in posts_en limit:1 %}
			<item>
				<title>{{ post.title | xml_escape }}</title>
				<description>{{ post.excerpt | xml_escape }}</description>
				<pubDate>{{ post.date | date: "%a, %d %b %Y %H:%M:%S %z" }}</pubDate>
				<link>{{ site.url }}{{ post.url }}</link>
				<guid isPermaLink="true">{{ site.url }}{{ post.url }}</guid>
			</item>
		{% endfor %}
	</channel>
</rss>
